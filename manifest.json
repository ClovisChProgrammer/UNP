{
  "manifest_version": 3,
  "name": "Ultimate Note Pad",
  "short_name": "UNT",
  "version": "0.1.0",
  "description": "Bloco de rascunhos com caneta no side panel: notas rápidas e cálculos à mão, com export PNG/JPG.",
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ultimate Note Pad (abrir/fechar painel)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
